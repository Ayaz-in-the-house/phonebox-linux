PhoneBox 0.6.9 — panel: 250 ms fast tick only when something needs it.
Why: setInterval(emit('fast'), 250) ran 4x per second whatever was on screen.
- armFast(): one-shot 250 ms tick only if a visible widget asks for 'fast' and its fastWanted() is true; re-armed after each update.
- media: fastWanted = playing and duration > 0 · stopwatch: fastWanted = running. Widgets without fastWanted keep the old behaviour.
Measured (10 s): paused media 40 -> 0 ticks · playing media (negative control) 40 -> 40, progress bar still moves.

diff --git a/android/app/src/main/assets/www/main.js b/android/app/src/main/assets/www/main.js
index 77e65d3..7c781fc 100644
--- a/android/app/src/main/assets/www/main.js
+++ b/android/app/src/main/assets/www/main.js
@@ -793,6 +793,21 @@ export function emit(kind) {
     if (!m.def.needs.includes(kind)) continue;
     if (act.has(m.pi)) runUpdate(m, kind); else m.dirty = true;
   }
+  armFast();
+}
+
+// The 4×/s "fast" tick runs only while a widget on screen moves between data updates (a playing media position, a running
+// stopwatch). A widget tells it with fastWanted(); one that needs 'fast' without saying so always gets it. Upstream ticked every
+// 250 ms whatever was on screen (UPSTREAM-STRATEGY P6, W3-PANEL.md TP-W3-06). armFast() is cheap and called after every update.
+export let fastTimer = 0;
+export function fastWanted() {
+  if (nightOn) return false;
+  const act = activeSet();
+  return mounted.some((m) => act.has(m.pi) && m.def.needs.includes('fast') && (typeof m.inst.fastWanted !== 'function' || m.inst.fastWanted()));
+}
+export function armFast() {
+  if (fastTimer || !fastWanted()) return;
+  fastTimer = setTimeout(() => { fastTimer = 0; emit('fast'); }, 250);
 }
 
