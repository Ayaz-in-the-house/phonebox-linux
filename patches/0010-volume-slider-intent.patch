PhoneBox 0.6.9 — panel: a page swipe never drags the volume slider.
Why (measured on the phone): a horizontal swipe that starts on the media widget's <input type=range> is taken by the native slider ->
volume jumps (16 unintended changes in 9 minutes) and the page does not move. Same class for the volume widget (.vb).
- intentSlide(): a horizontal gesture (|dx| >= |dy|, 10 px) belongs to the pager; value changes only on vertical drag or press-and-hold
  (280 ms) + drag; a single tap does not change the value; requests are rate-limited (<= 8/s) and the last value is always sent.

diff --git a/android/app/src/main/assets/www/main.js b/android/app/src/main/assets/www/main.js
index d002012..005978f 100644
--- a/android/app/src/main/assets/www/main.js
+++ b/android/app/src/main/assets/www/main.js
@@ -923,6 +923,48 @@ const release = () => {
 pager.addEventListener('touchend', (e) => { if (!e.touches.length) release(); }, { passive: true });
 pager.addEventListener('touchcancel', release, { passive: true });
 
+// Sliders inside the horizontal pager (media volume, volume widget). A sideways swipe is the pager's, never a value change — also when
+// it starts on a slider or while a page is still settling. A value changes only with intent: a vertical drag, or press-and-hold
+// (HOLD_MS) then any drag; a plain tap changes nothing. slide(d) gets the signed travel in px (right / up = more). W3-PANEL TP-W3-13..16.
+export const SLIDE_SLOP = 10, HOLD_MS = 280;
+export const VOL_SEND_MS = 120;   // ≤ 8 volume requests / s while dragging (card: ≤ 10 / s), the last value always goes out
+const pagerAtRest = () => !settling && Math.abs(pager.scrollLeft / window.innerWidth - Math.round(pager.scrollLeft / window.innerWidth)) < 0.005;
+export function intentSlide(el, { skip, start, slide, end }) {
+  let g = null;
+  const stop = () => { if (g) clearTimeout(g.hold); g = null; };
+  const grab = (x, y) => { g.mode = 'slide'; g.x = x; g.y = y; start(); };
+  el.addEventListener('touchstart', (e) => {
+    stop();
+    if (e.touches.length !== 1 || (skip && skip(e))) return;
+    const t = e.touches[0];
+    g = { x: t.clientX, y: t.clientY, mode: pagerAtRest() ? 'wait' : 'pan', hold: 0 };
+    if (g.mode === 'wait') g.hold = setTimeout(() => { if (g && g.mode === 'wait') { haptic(); grab(g.x, g.y); } }, HOLD_MS);
+  }, { passive: true });
+  el.addEventListener('touchmove', (e) => {
+    if (!g || g.mode === 'pan') return;
+    const t = e.touches[0], dx = t.clientX - g.x, dy = t.clientY - g.y;
+    if (g.mode === 'wait') {
+      if (Math.max(Math.abs(dx), Math.abs(dy)) < SLIDE_SLOP) return;
+      clearTimeout(g.hold);
+      if (Math.abs(dx) >= Math.abs(dy)) { g.mode = 'pan'; return; }   // sideways first: a page swipe, the pager scrolls natively
+      grab(t.clientX, t.clientY);
+      return;
+    }
+    e.preventDefault();   // the slider owns this touch: the pager must not scroll under it
+    const ex = t.clientX - g.x, ey = g.y - t.clientY;
+    slide(Math.abs(ex) >= Math.abs(ey) ? ex : ey);
+  }, { passive: false });
+  const fin = () => { if (g && g.mode === 'slide') end(); stop(); };
+  el.addEventListener('touchend', fin, { passive: true });
+  el.addEventListener('touchcancel', fin, { passive: true });
+}
+/** fn(v) at most once per ms; the last value always goes out (trailing call). */
+export function rateLimited(fn, ms = 100) {
+  let last = -Infinity, timer = 0, v;
+  const run = () => { timer = 0; last = performance.now(); fn(v); };
+  return (x) => { v = x; if (timer) return; const wait = last + ms - performance.now(); if (wait <= 0) run(); else timer = setTimeout(run, wait); };
+}
+
 export function goPage(i, instant = false) {
   i = Math.max(0, Math.min(pages.length - 1, i));
   if (!instant) { settle(i); return; }
