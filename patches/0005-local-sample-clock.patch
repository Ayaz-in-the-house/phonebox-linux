+
+// Charts sample on the panel's own 1 s clock (tick), not on agent events: a second without an event keeps the last value
+// instead of losing a sample, so the time axis stays even (EXPERIENCE-ARCHITECTURE.md K3 / TP-EX-01, W3-PANEL.md TP-W3-04).
+// This also lets the agent send state only when it changes later on. No event for 5 s (agent gone) → no samples, as before.
+export let histSeq = 0;   // counts samples; charts use it to draw only the newest slice (chart opts.seq)
+export let histPending = false;   // a sample not drawn yet
+export function sampleHist() {
+  const s = D.state, pc = s?.pc;
+  if (!pc || Date.now() - lastStateAt > 5000) return false;
+  pushHist('cpu', pc.cpu);
+  pushHist('gpu', pc.gpu?.util);
+  pushHist('ram', pc.ramUsedGb);
+  pushHist('vram', pc.gpu?.vramTotal ? (pc.gpu.vramUsed / pc.gpu.vramTotal) * 100 : 0);
+  pushHist('down', pc.netDownBps);
+  pushHist('up', pc.netUpBps);
+  pushHist('ping', s.ping?.ms);
+  pushHist('gputemp', pc.gpu?.temp);
+  pushHist('cputemp', pc.cpuTemp);
+  histSeq++;
+  return true;
 }
 
