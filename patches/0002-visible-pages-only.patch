-export function activeSet() { return new Set([curPage - 1, curPage, curPage + 1]); }
+// Pages on screen get fresh data: the current one, and its neighbours only while a finger is on the pager or a page is settling
+// (they show at the edges then). Off-screen pages are marked dirty and catch up when they come into view (setActive).
+// Upstream updated curPage ± 1 all the time, i.e. one or two pages nobody sees (W3-PANEL.md TP-W3-01).
+export function activeSet() {
+  if (dragging || settling) return new Set([curPage - 1, curPage, curPage + 1]);
+  const x = pager.scrollLeft / window.innerWidth;
+  return new Set([curPage, Math.floor(x), Math.ceil(x)]);
+}
