+
+/* ---------- dictation (patch 0013): hold to talk, bottom right on every page, above pages (z 8), below overlays ----------
+   52 px round (≥ 48 dp touch target), mostly over the page's 14 px / 17 px margins; clear of the page buttons in the middle. */
+#dictate {
+  position: fixed; z-index: 8; right: max(4px, env(safe-area-inset-right)); bottom: 4px;
+  width: 52px; height: 52px; padding: 0; border-radius: 50%; display: grid; place-items: center;
+  background: rgba(20, 24, 30, .82); border: 1px solid var(--line); color: var(--muted);
