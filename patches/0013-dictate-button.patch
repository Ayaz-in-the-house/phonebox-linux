PhoneBox 0.6.9 — panel: dictation button (assets/www only).
- Floating 52 px button bottom-right on every page (>= 48 dp; hidden on the night screen and in preview).
- Press and hold = record (MediaRecorder), release = send. < 300 ms or released before the mic opened -> no request.
  Auto-send at 55 s (agent's 2 MB cap). Converted client-side to 16 kHz mono 16-bit PCM WAV.
- Agent contract: POST /api/dictate (WAV) -> {text, ms, pasted} | 4xx/5xx {error}.

diff --git a/android/app/src/main/assets/www/dictate-audio.js b/android/app/src/main/assets/www/dictate-audio.js
new file mode 100644
index 0000000..adb4314
--- /dev/null
+++ b/android/app/src/main/assets/www/dictate-audio.js
@@ -0,0 +1,111 @@
+// Dictation audio arithmetic (patch 0013): any rate → 16 kHz mono 16-bit PCM WAV, the one format the speech engine on the PC
+// reads (phoned POST /api/dictate → herdr-web → Handy's whisper). Copied from the same owner's herdr-web
+// public/dictate-audio.js (PRD-185, windowed-sinc low-pass at 7 kHz before the 8 kHz fold); pure functions, no Web Audio.
+
+const OUT_RATE = 16000;
+const CUTOFF_HZ = 7000;
+const HALF_WIDTH = 24;
+const PHASES = 256;
+
+const sinc = (x) => (x === 0 ? 1 : Math.sin(Math.PI * x) / (Math.PI * x));
+const blackman = (u) => (Math.abs(u) >= 1 ? 0 : 0.42 + 0.5 * Math.cos(Math.PI * u) + 0.08 * Math.cos(2 * Math.PI * u));
+
+/** One kernel row per fractional phase, each summing to 1 (unity gain at DC). */
+function kernelTable(rate) {
+  const ratio = rate / OUT_RATE;
+  // Cycles per input sample: 7 kHz when reducing; the same fraction of the input's
+  // own band when a (rare) microphone records below 16 kHz.
+  const fc = ((CUTOFF_HZ / OUT_RATE) * Math.min(rate, OUT_RATE)) / rate;
+  const half = Math.ceil(HALF_WIDTH * Math.max(1, ratio));
+  const taps = 2 * half + 1;
+  const table = new Float32Array(PHASES * taps);
+  for (let p = 0; p < PHASES; p++) {
+    const frac = p / PHASES;
+    let sum = 0;
+    for (let k = 0; k < taps; k++) {
+      const d = k - half - frac;
+      const h = 2 * fc * sinc(2 * fc * d) * blackman(d / (half + 1));
+      table[p * taps + k] = h;
+      sum += h;
+    }
+    for (let k = 0; k < taps; k++) table[p * taps + k] /= sum;
+  }
+  return { table, half, taps };
+}
+
+/**
+ * Any rate → 16 kHz, low-passed so nothing above 8 kHz folds back into speech.
+ * @param {Float32Array} input mono samples in [-1, 1]
+ * @param {number} rate the input's sample rate
+ * @returns {Float32Array}
+ */
+export function downsampleTo16k(input, rate) {
+  if (rate === OUT_RATE) return input;
+  const ratio = rate / OUT_RATE;
+  const out = new Float32Array(Math.round(input.length / ratio));
+  if (out.length === 0) return out;
+  const { table, half, taps } = kernelTable(rate);
+  const n = input.length;
+  for (let i = 0; i < out.length; i++) {
+    const center = i * ratio;
+    let base = Math.floor(center);
+    let phase = Math.round((center - base) * PHASES);
+    if (phase === PHASES) {
+      phase = 0;
+      base++;
+    }
+    const row = phase * taps;
+    let acc = 0;
+    const first = base - half;
+    for (let k = 0; k < taps; k++) {
+      const j = first + k;
+      if (j >= 0 && j < n) acc += input[j] * table[row + k];
+    }
+    out[i] = acc;
+  }
+  return out;
+}
+
+/**
+ * Float samples → signed 16-bit, clipped at full scale.
+ * @param {Float32Array} input
+ * @returns {Int16Array}
+ */
+export function toInt16(input) {
+  const out = new Int16Array(input.length);
+  for (let i = 0; i < input.length; i++) {
+    const s = Math.max(-1, Math.min(1, input[i]));
+    out[i] = Math.round(s < 0 ? s * 32768 : s * 32767);
+  }
+  return out;
+}
+
+/**
+ * A 16 kHz mono 16-bit PCM WAV file around the samples.
+ * @param {Int16Array} samples
+ * @returns {Uint8Array}
+ */
+export function encodeWav16k(samples) {
+  const dataBytes = samples.length * 2;
+  const out = new Uint8Array(44 + dataBytes);
+  const view = new DataView(out.buffer);
+  const text = (at, s) => {
+    for (let i = 0; i < s.length; i++) out[at + i] = s.charCodeAt(i);
+  };
+  text(0, "RIFF");
+  view.setUint32(4, 36 + dataBytes, true);
+  text(8, "WAVE");
+  text(12, "fmt ");
+  view.setUint32(16, 16, true);
+  view.setUint16(20, 1, true); // PCM
+  view.setUint16(22, 1, true); // mono
+  view.setUint32(24, OUT_RATE, true);
+  view.setUint32(28, OUT_RATE * 2, true);
+  view.setUint16(32, 2, true);
+  view.setUint16(34, 16, true);
+  text(36, "data");
+  view.setUint32(40, dataBytes, true);
+  // Explicitly little-endian, whatever the platform's own order.
+  for (let i = 0; i < samples.length; i++) view.setInt16(44 + i * 2, samples[i], true);
+  return out;
+}
diff --git a/android/app/src/main/assets/www/dictate.js b/android/app/src/main/assets/www/dictate.js
new file mode 100644
index 0000000..70547d4
--- /dev/null
+++ b/android/app/src/main/assets/www/dictate.js
@@ -0,0 +1,162 @@
+// Dictation (patch 0013, PRD-DT01): the phone is the computer's microphone. Hold the button, speak, let go: the recording goes to
+// the agent (POST /agent/api/dictate, 16 kHz mono 16-bit WAV) which turns it into text on the PC and types it where the PC's focus
+// is. The result is shown here briefly. Nothing is kept on the phone.
+//
+// One floating button on every page (bottom right, above the pages, below overlays): dictation must be one hold away from
+// whatever page is showing, so it is not a page of its own and not a widget that has to be placed first.
+//
+// MediaRecorder, not an AudioContext graph: a touch's pointerdown is not a user activation (activation comes when the finger
+// lifts), so an AudioContext started on press can stay suspended and record silence (herdr-web ADR-231). The recorded file is
+// decoded with OfflineAudioContext (no activation needed) and converted here (dictate-audio.js).
+//
+// The native proxy never sees a request's body (WebView shouldInterceptRequest), so on the phone the WAV is first staged through
+// the bridge (patch 0012, Android.stageBody) and the request names it in X-PhoneBox-Body. The body is also sent as usual, so the
+// panel works the same in a plain browser.
+import { API, PANEL_HEADERS, PREVIEW, bridge, haptic, h } from './main.js';
+import { downsampleTo16k, toInt16, encodeWav16k } from './dictate-audio.js';
+
+/** Shorter than this is a stray touch: nothing is sent (TP-DT-11). */
+export const MIN_HOLD_MS = 300;
+/** phoned takes at most 2 MB (≈ 65 s at 16 kHz); the recording stops and is sent a little before that. */
+export const MAX_HOLD_MS = 55_000;
+const CONSTRAINTS = { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true };
+const SHOW_MS = { done: 4000, empty: 2500, short: 2000, denied: 4500, error: 4500 };
+const LABEL = {
+  idle: 'Dikte — basılı tut, konuş, bırak', opening: 'Mikrofon açılıyor', rec: 'Dinliyorum — bırakınca gönderilir',
+  sending: 'Yazıya çevriliyor', done: 'Yazıldı', empty: 'Söz duyulmadı', short: 'Basılı tut', denied: 'Mikrofon izni yok', error: 'Dikte hatası',
+};
+const MIC = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21M8.5 21h7"/></svg>';
+
+let btn, out;
+let state = 'idle';
+let held = false;
+let downAt = 0;
+let press = 0;            // id of the current press; a late microphone for an older press is let go
+let stream = null;
+let rec = null;
+let chunks = [];
+let discard = false;
+let maxTimer = 0, tickTimer = 0, hideTimer = 0, idleTimer = 0;
+
+function show(next, msg = '', kind = '') {
+  state = next;
+  btn.dataset.state = next;
+  btn.setAttribute('aria-label', LABEL[next] || LABEL.idle);
+  clearTimeout(hideTimer); clearTimeout(idleTimer);
+  if (msg) { out.textContent = msg; out.className = 'on ' + kind; } else out.className = '';
+  if (SHOW_MS[next]) hideTimer = setTimeout(() => {
+    out.className = '';
+    idleTimer = setTimeout(() => { if (state === next) { show('idle'); out.textContent = ''; } }, 250);
+  }, SHOW_MS[next]);
+}
+
+function letGo(s) { for (const t of s?.getTracks?.() ?? []) t.stop(); }
+function releaseMic() { letGo(stream); stream = null; clearInterval(tickTimer); clearTimeout(maxTimer); }
+
+const secs = () => { const s = Math.floor((performance.now() - downAt) / 1000); return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0'); };
+
+async function onDown(e) {
+  if (held || state === 'opening' || state === 'rec' || state === 'sending') return;
+  e.preventDefault();
+  try { btn.setPointerCapture(e.pointerId); } catch (_) {}
+  held = true; downAt = performance.now();
+  const id = ++press;
+  haptic();
+  show('opening', 'Mikrofon açılıyor…');
+  let s;
+  try {
+    s = await navigator.mediaDevices.getUserMedia({ audio: CONSTRAINTS });
+  } catch (err) {
+    held = false;
+    if (err?.name === 'NotAllowedError' || err?.name === 'SecurityError') return show('denied', 'Mikrofon izni yok — Ayarlar › Uygulamalar › PhoneBox › İzinler', 'err');
+    return show('error', 'Mikrofon açılamadı: ' + (err?.name || err), 'err');
+  }
+  // let go while Android asked for the permission or the microphone was opening: nothing is recorded (TP-DT-11)
+  if (id !== press) { letGo(s); return; }   // onUp bumps press while the microphone opens
+  stream = s; chunks = []; discard = false;
+  rec = new MediaRecorder(s, { audioBitsPerSecond: 128_000 });
+  rec.ondataavailable = (ev) => { if (ev.data && ev.data.size > 0) chunks.push(ev.data); };
+  rec.onstop = () => finish(rec);
+  rec.start(1000);
+  show('rec', 'Dinliyorum… 0:00', 'rec');
+  tickTimer = setInterval(() => { if (state === 'rec') out.textContent = 'Dinliyorum… ' + secs(); }, 500);
+  maxTimer = setTimeout(() => onUp(null), MAX_HOLD_MS);
+}
+
+function onUp(e, cancel = false) {
+  if (!held) return;
+  held = false;
+  const tooShort = performance.now() - downAt < MIN_HOLD_MS;
+  if (state === 'opening') { press++; return show('short', 'Basılı tut, konuş, bırak'); }
+  if (state !== 'rec') return;
+  discard = cancel || tooShort;
+  try { rec.stop(); } catch (_) {}
+  releaseMic();
+  if (cancel) show('idle');
+  else if (tooShort) show('short', 'Basılı tut, konuş, bırak');
+  else show('sending', 'Yazıya çevriliyor…');
+}
+
+async function finish(r) {
+  const parts = chunks; chunks = [];
+  if (discard) return;
+  try {
+    const bytes = await new Blob(parts, { type: r.mimeType }).arrayBuffer();
+    if (bytes.byteLength === 0) return show('empty', 'Söz duyulmadı');
+    const audio = await new OfflineAudioContext(1, 1, 48000).decodeAudioData(bytes);
+    const mono = new Float32Array(audio.length);
+    for (let c = 0; c < audio.numberOfChannels; c++) { const d = audio.getChannelData(c); for (let i = 0; i < mono.length; i++) mono[i] += d[i] / audio.numberOfChannels; }
+    await send(encodeWav16k(toInt16(downsampleTo16k(mono, audio.sampleRate))));
+  } catch (err) {
+    show('error', 'Kayıt çözülemedi', 'err');
+  }
+}
+
+function base64(bytes) {
+  let s = '';
+  for (let i = 0; i < bytes.length; i += 0x8000) s += String.fromCharCode.apply(null, bytes.subarray(i, i + 0x8000));
+  return btoa(s);
+}
+
+async function send(wav) {
+  const headers = { ...PANEL_HEADERS, 'Content-Type': 'audio/wav' };
+  if (bridge?.stageBody) {
+    const id = bridge.stageBody(base64(wav));
+    if (!id) return show('error', 'Dikte: ses telefondan aktarılamadı', 'err');
+    headers['X-PhoneBox-Body'] = id;
+  }
+  const ctl = new AbortController();
+  const t = setTimeout(() => ctl.abort(), 25_000);
+  try {
+    const r = await fetch(API + '/dictate', { method: 'POST', headers, body: wav, signal: ctl.signal, cache: 'no-store' });
+    let j = {};
+    try { j = await r.json(); } catch (_) {}
+    if (!r.ok) return show('error', r.status === 503 && j.error === 'offline' ? 'PC bağlı değil' : 'Dikte hatası: ' + (j.error || 'HTTP ' + r.status), 'err');
+    const text = String(j.text || '').trim();
+    if (!text) return show('empty', 'Söz duyulmadı');
+    haptic();
+    show('done', '✓ ' + text + (j.pasted === false ? ' (yapıştırılmadı)' : ''), 'ok');
+  } catch (err) {
+    show('error', err?.name === 'AbortError' ? 'Dikte zaman aşımı' : 'PC bağlı değil', 'err');
+  } finally { clearTimeout(t); }
+}
+
+export function initDictate() {
+  if (PREVIEW || !navigator.mediaDevices?.getUserMedia || typeof MediaRecorder === 'undefined') return;
+  btn = h('button', null);
+  btn.id = 'dictate';
+  btn.type = 'button';
+  btn.innerHTML = MIC;
+  out = h('div', null);
+  out.id = 'dictateOut';
+  out.setAttribute('role', 'status');
+  out.setAttribute('aria-live', 'polite');
+  document.body.append(out, btn);
+  show('idle');
+  btn.addEventListener('pointerdown', onDown);
+  btn.addEventListener('pointerup', (e) => onUp(e));
+  btn.addEventListener('pointercancel', (e) => onUp(e, true));
+  btn.addEventListener('contextmenu', (e) => e.preventDefault());
+  // the app went to the background mid-recording: drop it, never leave the microphone open
+  document.addEventListener('visibilitychange', () => { if (document.hidden) onUp(null, true); });
+}
