+  transition: background .15s, border-color .15s, box-shadow .15s, color .15s;
+}
+#dictate svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
+#dictate svg rect { fill: currentColor; stroke: none; }
